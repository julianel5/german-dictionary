# --- Backend (FastAPI) ---

# PostgreSQL via Docker Compose. For a zero-setup local fallback the API
# automatically uses SQLite (data/dev.db) when DATABASE_URL is unset.
DATABASE_URL=postgresql+psycopg://dictionary:dictionary@localhost:5432/dictionary

# Optional search-result cache. Leave empty to disable caching.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# Morphology engine: auto | spacy | fixture | none
#   auto    - use spaCy if the model is installed, otherwise no engine
#   fixture - deterministic fixture engine (tests / offline demos only)
MORPHOLOGY_ENGINE=auto
SPACY_MODEL=de_core_news_sm

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend (Nuxt) ---
# Base URL the browser uses to reach the API.
NUXT_PUBLIC_API_BASE=http://localhost:8000
